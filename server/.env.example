# Modelo: tiny | base | small | medium | large-v3 | large-v3-turbo
#   Solo CPU  -> small (equilibrado) o base (rápido)
#   GPU NVIDIA -> large-v3-turbo (casi perfecto y rápido)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | float16 | int8_float16
WHISPER_COMPUTE=auto
LANGUAGE=es
# Déjelo vacío en LAN. Para exponerlo (F3) ponga uno largo:  openssl rand -hex 24
API_KEY=
MAX_UPLOAD_MB=200
HOST=0.0.0.0
PORT=8000
